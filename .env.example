# Copy to .env.local and fill in. Restart the dev server after changes.

# --- AI assistant (OpenAI) ---
OPENAI_API_KEY=
# Optional: override the model (defaults to gpt-4.1-mini, matching the voice
# assistant). Set gpt-4.1 for higher web/SMS quality.
# OPENAI_MODEL=gpt-4.1-mini

# --- Supabase (auth + data) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Voice (Vapi) + SMS/sending (Twilio) ---
VAPI_PRIVATE_KEY=
VAPI_PUBLIC_KEY=
# REQUIRED in production: shared secret Vapi sends as the x-vapi-secret header.
# The voice webhooks FAIL CLOSED without it (every call is rejected), so it must
# match the value configured on the Vapi assistant + phone number.
VAPI_SERVER_SECRET=
TWILIO_ACCOUNT_SID=
# REQUIRED in production: used to validate Twilio's request signature. The SMS
# webhook now FAILS CLOSED without it (returns 503) so a spoofed `From` can't
# drive the assistant on a registered account. Must be the account's auth token.
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+14752703374
# DEV ONLY: set to 1 to skip Twilio request-signature validation. Never set in
# production (it is force-ignored when NODE_ENV=production).
# TWILIO_SKIP_VALIDATION=

# --- App ---
# Public base URL, used for share links and assistant invites.
NEXT_PUBLIC_SITE_URL=https://pheme.deals
# Signs share/sign capability links (HMAC). Optional: falls back to the
# service-role key if unset. Recommended to set a dedicated 32+ byte random
# value so rotating the DB key doesn't invalidate links — but note that
# CHANGING this value invalidates all outstanding share/sign links.
SHARE_SECRET=

# --- Email delivery (Resend) — filled PDFs, auth links, billing notices ---
# Create a key at resend.com and verify the sending domain (pheme.deals).
# Password reset + assistant invites are delivered through Resend (not
# Supabase's built-in mailer), so this is REQUIRED in production.
RESEND_API_KEY=
EMAIL_FROM=Pheme <documents@pheme.deals>

# --- Billing (Stripe) ---
# Without STRIPE_SECRET_KEY the app runs in free "beta" mode: everything
# unlocked, no gating, no charges. With it set, plans/trials/voice-minute
# metering are enforced.
# Secret key: dashboard.stripe.com → Developers → API keys (sk_test_… in
# sandbox, sk_live_… in live mode).
STRIPE_SECRET_KEY=
# Signing secret for the /api/stripe/webhook endpoint (whsec_…). Created with
# the webhook endpoint; a live-mode endpoint gets its own value.
STRIPE_WEBHOOK_SECRET=
# Prices are resolved by lookup_key ({solo,pro,brokerage}_{monthly,annual}) —
# no price IDs in env. Going live = recreate the catalog with the same
# lookup keys and swap the two values above to their live equivalents.
